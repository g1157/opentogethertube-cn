# Copy or generate this file as .env beside compose.yml; do not commit the resulting secrets.
# Use 18080 for independent acceptance, then 8080 after releasing the old application's port.
OTT_PUBLIC_PORT=18080
OTT_PUBLIC_HOSTNAME=YOUR_HOST:18080

# Generate unique random hexadecimal values. See DEPLOYMENT.md for a command that writes them privately.
POSTGRES_PASSWORD=
SESSION_SECRET=
ADMIN_API_KEY=
