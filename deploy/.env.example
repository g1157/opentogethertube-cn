# Copy or generate this file as .env beside compose.yml; do not commit the resulting secrets.
# Single production instance: keep these names, cookie names, and secrets across upgrades.
OTT_PROJECT_NAME=ott
OTT_IMAGE=ghcr.io/g1157/opentogethertube-cn:latest
OTT_INSTANCE_ID=ott
OTT_AUTH_COOKIE_NAME=ott_token
OTT_SESSION_COOKIE_NAME=ott_sid

# Host port and public hostname (no protocol or path).
OTT_PUBLIC_PORT=8080
OTT_PUBLIC_HOSTNAME=YOUR_HOST:8080
FFPROBE_STRATEGY=run

# Behind Cloudflare Tunnel or a single reverse proxy use 1 so rate limits apply per visitor IP.
TRUST_PROXY=0

# Generate unique random hexadecimal values. See DEPLOYMENT.md for a command that writes them privately.
POSTGRES_PASSWORD=
SESSION_SECRET=
ADMIN_API_KEY=
