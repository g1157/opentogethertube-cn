# Copy or generate this file as .env beside compose.yml; do not commit the resulting secrets.
# Fresh acceptance instance: choose names that are not already used on this host.
# Existing production upgrades retain their own project, instance, cookie names, and secrets.
OTT_PROJECT_NAME=ott-preview
OTT_IMAGE=ott-preview:0.15.0-cn9
OTT_INSTANCE_ID=ott-preview
OTT_AUTH_COOKIE_NAME=ott_preview_token
OTT_SESSION_COOKIE_NAME=ott_preview_sid

# Use 18080 for independent acceptance, then 8080 after releasing the old application's port.
OTT_PUBLIC_PORT=18080
OTT_PUBLIC_HOSTNAME=YOUR_HOST:18080
FFPROBE_STRATEGY=run

# Generate unique random hexadecimal values. See DEPLOYMENT.md for a command that writes them privately.
POSTGRES_PASSWORD=
SESSION_SECRET=
ADMIN_API_KEY=
